NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/sheet-saas
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_URL=http://localhost:5173

# Use 1 when one trusted reverse proxy (for example Nginx) is in front of Node.
TRUST_PROXY=false

# Enable only when HTTPS terminates before the Node process.
FORCE_HTTPS=false

# Log API requests slower than this threshold.
PERF_LOG_THRESHOLD_MS=250
